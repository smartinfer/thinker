        "model": {
          "title": "Model",
          "type": "string"
        },
        "prompt_sha256": {
          "title": "Prompt Sha256",
          "type": "string"
        },
        "provider": {
          "enum": [
            "openai",
            "anthropic",
            "gemini"
          ],
