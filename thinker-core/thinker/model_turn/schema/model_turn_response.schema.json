{
  "$defs": {
    "Continuation": {
      "additionalProperties": false,
      "description": "Opaque provider transport state, never agent or project memory.",
      "properties": {
        "token": {
          "minLength": 1,
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "token"
      ],
      "title": "Continuation",
      "type": "object"
    },
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Amount",
          "type": "number"
        },
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        }
      },
      "title": "Cost",
      "type": "object"
    },
    "JsonValue": {},
    "ModelTurnError": {
      "additionalProperties": false,
      "description": "A sanitized provider-neutral failure returned instead of an exception.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ModelTurnErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "provider_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Code"
        },
        "provider_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Status"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ModelTurnError",
      "type": "object"
    },
    "ModelTurnErrorCode": {
      "enum": [
        "ModelUnavailable",
        "AuthenticationFailure",
        "RateLimited",
        "ProviderOverloaded",
        "RequestTimeout",
        "Cancelled",
        "MalformedResponse",
        "ToolCallMalformed",
        "StructuredOutputViolation",
        "UnknownProviderFailure",
        "Incomplete"
      ],
      "title": "ModelTurnErrorCode",
      "type": "string"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "name",
        "arguments"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cached_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Input Tokens"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "provider_details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Provider Details",
          "type": "object"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        },
        "total_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assistant_content": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assistant Content"
    },
    "continuation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Continuation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cost": {
      "$ref": "#/$defs/Cost"
    },
    "duration_ms": {
      "default": 0.0,
      "minimum": 0.0,
      "title": "Duration Ms",
      "type": "number"
    },
    "finish_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finish Reason"
    },
    "normalized_error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelTurnError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "protocol_version": {
      "const": "thinker.model-turn.v1",
      "default": "thinker.model-turn.v1",
      "title": "Protocol Version",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "requested_route": {
      "title": "Requested Route",
      "type": "string"
    },
    "resolved_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved Model"
    },
    "resolved_provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved Provider"
    },
    "resolved_route": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved Route"
    },
    "structured_output": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "thinker_revision": {
      "title": "Thinker Revision",
      "type": "string"
    },
    "thinker_version": {
      "title": "Thinker Version",
      "type": "string"
    },
    "tool_calls": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolCall"
      },
      "title": "Tool Calls",
      "type": "array"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
  },
  "required": [
    "request_id",
    "thinker_version",
    "thinker_revision",
    "requested_route"
  ],
  "title": "ModelTurnResponse",
  "type": "object"
}
