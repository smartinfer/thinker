    "ModelTurnErrorCode": {
      "enum": [
        "ModelUnavailable",
        "AuthenticationFailure",
        "RateLimited",
        "ProviderOverloaded",
        "RequestTimeout",
        "Cancelled",
        "MalformedResponse",
        "ToolCallMalformed",
        "StructuredOutputViolation",
        "UnknownProviderFailure",
        "Incomplete"
