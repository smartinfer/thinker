        "json_mode": {
          "default": "UNSUPPORTED",
          "enum": [
            "NATIVE",
            "EMULATED",
            "UNSUPPORTED"
          ],
          "title": "Json Mode",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "enum": [
            "openai",
            "anthropic",
            "gemini"
          ],
          "title": "Provider",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "streaming": {
          "default": "UNSUPPORTED",
          "enum": [
            "NATIVE",
            "EMULATED",
            "UNSUPPORTED"
          ],
          "title": "Streaming",
          "type": "string"
        },
        "structured_output": {
          "default": "UNSUPPORTED",
          "enum": [
            "NATIVE",
            "EMULATED",
            "UNSUPPORTED"
          ],
          "title": "Structured Output",
          "type": "string"
        },
        "tools": {
          "default": "UNSUPPORTED",
          "enum": [
            "NATIVE",
            "EMULATED",
            "UNSUPPORTED"
          ],
          "title": "Tools",
          "type": "string"
        },
        "vision": {
          "default": "UNSUPPORTED",
          "enum": [
            "NATIVE",
            "EMULATED",
            "UNSUPPORTED"
          ],
          "title": "Vision",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "source"
      ],
      "title": "CapabilityProfile",
      "type": "object"
    },
    "Continuation": {
      "additionalProperties": false,
      "description": "Opaque provider transport state, never agent or project memory.",
      "properties": {
        "token": {
          "minLength": 1,
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "token"
      ],
      "title": "Continuation",
      "type": "object"
    },
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Amount",
          "type": "number"
