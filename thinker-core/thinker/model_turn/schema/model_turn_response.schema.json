        "request_sha256": {
          "title": "Request Sha256",
          "type": "string"
        },
        "revision": {
          "default": "unversioned",
          "title": "Revision",
          "type": "string"
        },
        "route": {
          "title": "Route",
          "type": "string"
        },
        "schema_sha256": {
          "title": "Schema Sha256",
          "type": "string"
        },
        "settings_sha256": {
          "title": "Settings Sha256",
          "type": "string"
        },
        "thinking": {
          "$ref": "#/$defs/ThinkingControl"
