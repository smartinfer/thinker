    "JsonValue": {},
    "ModelTurnError": {
      "additionalProperties": false,
      "description": "A sanitized provider-neutral failure returned instead of an exception.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ModelTurnErrorCode"
