{
  "$defs": {
    "Continuation": {
      "additionalProperties": false,
      "description": "Opaque provider transport state, never agent or project memory.",
      "properties": {
        "token": {
          "minLength": 1,
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "token"
      ],
      "title": "Continuation",
      "type": "object"
    },
    "GenerationParameters": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "default": 1024,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningEffort"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "stop": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Stop",
          "type": "array"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "top_p": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "title": "GenerationParameters",
      "type": "object"
    },
    "JsonValue": {},
    "MessageRole": {
      "enum": [
        "system",
        "user",
        "assistant"
      ],
      "title": "MessageRole",
      "type": "string"
    },
    "ModelMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "role": {
          "$ref": "#/$defs/MessageRole"
        },
        "tool_calls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "title": "Tool Calls",
          "type": "array"
        }
      },
      "required": [
        "role"
      ],
      "title": "ModelMessage",
      "type": "object"
    },
    "ReasoningEffort": {
      "description": "Provider-neutral reasoning-effort level for a model turn. Absence (field\nunset / None) preserves prior behavior; NONE explicitly disables reasoning.\nProvider mapping is capability-gated at the route (see runtime dispatch).",
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "title": "ReasoningEffort",
      "type": "string"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "name",
        "arguments"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "ToolDefinition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Input Schema",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Name",
          "type": "string"
        },
        "strict": {
          "default": true,
          "title": "Strict",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "description",
        "input_schema"
      ],
      "title": "ToolDefinition",
      "type": "object"
    },
    "ToolResult": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "is_error": {
          "default": false,
          "title": "Is Error",
          "type": "boolean"
        },
        "output": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "call_id",
        "output"
      ],
      "title": "ToolResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "continuation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Continuation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "generation": {
      "$ref": "#/$defs/GenerationParameters"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/ModelMessage"
      },
      "title": "Messages",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "protocol_version": {
      "const": "thinker.model-turn.v1",
      "default": "thinker.model-turn.v1",
      "title": "Protocol Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "requested_route": {
      "minLength": 1,
      "title": "Requested Route",
      "type": "string"
    },
    "response_schema": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Schema"
    },
    "system_instruction": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "System Instruction"
    },
    "timeout_ms": {
      "default": 30000,
      "maximum": 3600000,
      "minimum": 1,
      "title": "Timeout Ms",
      "type": "integer"
    },
    "tool_results": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolResult"
      },
      "title": "Tool Results",
      "type": "array"
    },
    "tools": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolDefinition"
      },
      "title": "Tools",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "requested_route",
    "messages"
  ],
  "title": "ModelTurnRequest",
  "type": "object"
}
