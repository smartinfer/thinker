{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "enum": ["0.3"]
    },
    "intent": {
      "type": "string",
      "enum": ["chat", "embed", "ocr", "doc_extract", "docai_extract"]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": ["user", "assistant", "system"]
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["text", "image_url", "document"]
                },
                "text": {
                  "type": "string"
                },
                "image_url": {
                  "type": "object",
                  "properties": {
                    "url": {"type": "string"},
                    "detail": {"type": "string", "enum": ["low", "high", "auto"]}
                  },
                  "required": ["url"]
                },
                "document": {
                  "type": "object",
                  "properties": {
                    "content": {"type": "string"},
                    "mime_type": {"type": "string"}
                  },
                  "required": ["content"]
                }
              },
              "required": ["type"]
            }
          }
        },
        "required": ["role", "parts"]
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "content": {"type": "string"},
          "mime_type": {"type": "string"}
        },
        "required": ["content"]
      }
    },
    "instructions": {
      "type": "object",
      "properties": {
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "json_schema": {"type": "object"}
      }
    },
    "routing": {
      "type": "object",
      "properties": {
        "call_id": {"type": "string"},
        "model": {"type": "string"},
        "alias": {"type": "string"}
      }
    }
  },
  "required": ["version", "intent", "messages"]
}
