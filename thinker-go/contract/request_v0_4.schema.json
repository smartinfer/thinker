{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThinkerQL 0.4 request",
  "description": "Envelope checks only; model output and opaque provider data are preserved.",
  "type": "object",
  "properties": {
    "version": {
      "const": "0.4"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "enum": [
        "chat",
        "embed",
        "ocr",
        "doc_extract",
        "docai_extract"
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "mime_type": {
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "additionalProperties": false
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "input_schema": {
            "type": "object"
          },
          "strict": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "input_schema"
        ],
        "additionalProperties": false
      }
    },
    "tool_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool_result"
      }
    },
    "instructions": {
      "type": "object",
      "properties": {
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "temperature": {
          "type": "number"
        },
        "top_p": {
          "type": "number"
        },
        "seed": {
          "type": "integer"
        },
        "stop": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "json_schema": {
          "type": "object",
          "description": "Optional caller-owned output schema, including enum vocabularies. Forwarded to the provider; never used to accept, reject, or repair generated content. The caller selects a compatible model."
        },
        "json_schema_strict": {
          "type": "boolean",
          "description": "Optional native strict flag for Chat Completions and Responses. Requires json_schema. Omission leaves provider defaults in effect; other protocols reject this flag explicitly."
        }
      },
      "required": [],
      "dependentRequired": {
        "json_schema_strict": ["json_schema"]
      },
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "properties": {
        "route_id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "enum": [
            "simple",
            "intermediate",
            "hard"
          ]
        },
        "reasoning": {
          "type": "object"
        },
        "local_mode": {
          "enum": [
            "off",
            "only",
            "assist"
          ]
        },
        "local_route_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "route_id",
              "model"
            ]
          }
        },
        {
          "not": {
            "required": [
              "route_id",
              "alias"
            ]
          }
        },
        {
          "not": {
            "required": [
              "model",
              "alias"
            ]
          }
        }
      ]
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1
    },
    "continuation": {},
    "provider_options": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "request_id",
    "intent",
    "messages"
  ],
  "additionalProperties": false,
  "$defs": {
    "part": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "image_url"
            },
            "image_url": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "detail": {
                  "enum": [
                    "auto",
                    "low",
                    "high"
                  ]
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "image_url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "document"
            },
            "document": {
              "type": "object",
              "properties": {
                "content": {
                  "type": "string"
                },
                "mime_type": {
                  "type": "string"
                }
              },
              "required": [
                "content"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "document"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "provider"
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "data": {}
          },
          "required": [
            "type",
            "provider",
            "data"
          ],
          "additionalProperties": false
        }
      ]
    },
    "message": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ]
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool_call"
          }
        },
        "tool_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool_result"
          }
        },
        "provider_data": {}
      },
      "required": [
        "role"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "parts"
          ],
          "properties": {
            "parts": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "tool_calls"
          ],
          "properties": {
            "tool_calls": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "tool_results"
          ],
          "properties": {
            "tool_results": {
              "minItems": 1
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "assistant"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "tool_calls"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "tool"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "tool_results"
              ]
            }
          }
        }
      ]
    },
    "tool_call": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "arguments": {},
        "provider_data": {}
      },
      "required": [],
      "additionalProperties": false
    },
    "tool_result": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "output": {},
        "is_error": {
          "type": "boolean"
        }
      },
      "required": [
        "call_id",
        "output"
      ],
      "additionalProperties": false
    }
  }
}
